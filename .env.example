# Lineage — environment template. Copy to `.env` (gitignored) and fill in.
#   cp .env.example .env
# Never commit `.env`. Never paste real values into this file.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# CockroachDB Cloud connection string (Cloud console -> cluster -> Connect).
# Accepts postgresql:// — app/config.py rewrites it to the cockroachdb+psycopg driver and
# appends certifi's CA bundle when sslmode=verify-full (bundled libpq 14 has no
# sslrootcert=system, and libpq on Windows does not read the OS trust store).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# REQUIRED TO BE PRESENT — even for scripts that never call OpenAI.
# app/config.py declares this with NO default, so anything importing app.db (including the
# read-only verify_* scripts) dies at import with a pydantic ValidationError if it is absent.
# It must EXIST; only scripts/ingest_corpus.py, scripts/ingest_regulatory.py and the agent
# path need it to be VALID. CI deliberately runs with a dummy value.
OPENAI_API_KEY=sk-...

# ── OPTIONAL — AWS (S3 certificates + the certifier Lambda) ──────────────────
# The app degrades gracefully without these: POST /beliefs/{id}/invalidate still returns 200
# with certificate_status:"failed". ONE test asserts the happy branch and will fail without
# them — tests/test_atomic_invalidation.py::test_certificate_round_trips_from_s3_and_hash_verifies
# (deselect it, or set these). Nothing in the suite is mocked; that is deliberate.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=

# ── OPTIONAL — evals and tooling (no app code path reads these) ──────────────
# NVIDIA NIM judge for scripts/eval_grounding.py (the RAG-faithfulness eval). Never OpenAI.
NVIDIA_API_KEY=

# LlamaParse, for scripts/parse_regulatory.py ONLY — re-deriving data/corpus/*.md from the
# source PDFs. You almost certainly do NOT need this: the parsed markdown IS committed and is
# what scripts/ingest_regulatory.py actually reads. Run it in an ISOLATED venv if you ever do;
# llama-cloud-services upgrades SQLAlchemy and numpy out from under the app.
LLAMA_CLOUD_API_KEY=

# CockroachDB Cloud cluster id — used only by .mcp.json (see .mcp.json.example), never by the app.
COCKROACH_CLUSTER_ID=
